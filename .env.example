# Copy to `.env.local` and fill in values. `.env.local` is gitignored.
# Supabase: https://supabase.com/dashboard → Project → Settings → API
#
# Client key: use either the publishable key (sb_publishable_…) or the legacy
# anon JWT (eyJ…). Both work for the browser client — same env var name.

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY

# After Step 3b — from Authentication → Users (not VITE_ — not exposed to the client bundle)
# CAREWATCH_VOLUNTEER_USER_UUID=
# CAREWATCH_STAFF_USER_UUID=

# Optional — set after running supabase/schema.sql in the SQL Editor
# CAREWATCH_SCHEMA_APPLIED=1

# Auth (dev): Supabase → Authentication → URL Configuration → Redirect URLs:
#   http://localhost:5173/**

# If you use Next.js instead of Vite, expose the same values with your framework’s
# public prefix (e.g. NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY).
